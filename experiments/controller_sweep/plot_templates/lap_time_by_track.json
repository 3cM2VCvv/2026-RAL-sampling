{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Mean lap time per track over runs that completed at least one lap, one bar per controller. Tracks are sorted from fastest to slowest so controller differences can be read against each map's baseline.",
  "title": "<DVC_METRIC_TITLE>",
  "width": {"step": 54},
  "height": 300,
  "data": {"values": "<DVC_METRIC_DATA>"},
  "transform": [
    {"filter": "toNumber(datum.num_laps_complete) > 0"},
    {"calculate": "toNumber(datum['<DVC_METRIC_Y>'])", "as": "lap_time"}
  ],
  "mark": {"type": "bar"},
  "encoding": {
    "x": {
      "field": "<DVC_METRIC_X>",
      "type": "nominal",
      "title": "<DVC_METRIC_X_LABEL>",
      "sort": {"field": "lap_time", "op": "mean", "order": "ascending"},
      "axis": {"labelAngle": 0}
    },
    "xOffset": {"field": "controller", "type": "nominal"},
    "y": {
      "aggregate": "mean",
      "field": "lap_time",
      "type": "quantitative",
      "title": "<DVC_METRIC_Y_LABEL>"
    },
    "color": {
      "field": "controller",
      "type": "nominal",
      "title": "Controller",
      "scale": {"domain": ["immrax", "shieldmppi", "tubemppi"], "range": ["#1f77b4", "#ff7f0e", "#9467bd"]},
      "legend": {"labelExpr": "datum.value == 'shieldmppi' ? 'Shield-MPPI' : datum.value == 'tubemppi' ? 'Tube-MPPI' : 'Immrax'"}
    },
    "tooltip": [
      {"field": "<DVC_METRIC_X>", "type": "nominal", "title": "<DVC_METRIC_X_LABEL>"},
      {"field": "controller", "type": "nominal", "title": "Controller"},
      {"aggregate": "mean", "field": "lap_time", "type": "quantitative", "title": "Mean lap time (s)", "format": ".2f"},
      {"aggregate": "count", "type": "quantitative", "title": "Trials with completed laps"}
    ]
  },
  "config": {
    "font": "CMU Serif",
    "title": {"font": "CMU Serif", "anchor": "middle", "fontSize": 22.5, "fontWeight": "normal"},
    "axis": {"labelFont": "CMU Serif", "titleFont": "CMU Serif", "titleFontWeight": "normal", "labelFontSize": 16.5, "titleFontSize": 18},
    "legend": {"labelFont": "CMU Serif", "titleFont": "CMU Serif", "titleFontWeight": "normal", "labelFontSize": 16.5, "titleFontSize": 18, "titleLimit": 400},
    "header": {"labelFont": "CMU Serif", "titleFont": "CMU Serif", "titleFontWeight": "normal", "labelFontSize": 18, "titleFontSize": 18},
    "text": {"font": "CMU Serif"},
    "view": {"stroke": "transparent"}
  }
}
