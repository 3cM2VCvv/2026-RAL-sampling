{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Failure count by initial lateral offset for ONE failure mode. The mode is passed in through DVC's `y_label` property ('crash' or 'stall') and `title` supplies the heading, so dvc.yaml can bind this one template twice - once per outcome - instead of faceting both modes into a single figure.",
  "title": "<DVC_METRIC_TITLE>",
  "data": {"values": "<DVC_METRIC_DATA>"},
  "transform": [{"filter": "datum.outcome == '<DVC_METRIC_Y_LABEL>'"}],
  "facet": {
    "column": {
      "field": "rev",
      "type": "nominal",
      "title": null,
      "header": {"labels": false}
    }
  },
  "spec": {
    "mark": {"type": "bar"},
    "width": {"step": 34},
    "encoding": {
      "x": {
        "field": "init_offset_name",
        "type": "nominal",
        "title": "Initial lateral offset",
        "sort": ["inside", "center", "outside"],
        "axis": {
          "labelAngle": 0,
          "labelExpr": "upper(slice(datum.value, 0, 1)) + slice(datum.value, 1)"
        }
      },
      "xOffset": {"field": "use_reachsets", "type": "nominal"},
      "y": {"aggregate": "count", "title": "Number of runs"},
      "color": {
        "field": "use_reachsets",
        "type": "nominal",
        "title": "Reachable-set filter",
        "scale": {"domain": ["False", "True"], "range": ["#1f77b4", "#ff7f0e"]},
        "legend": {"labelExpr": "datum.label == 'True' ? 'Enabled' : 'Disabled'"}
      },
      "tooltip": [
        {"field": "outcome", "type": "nominal", "title": "Failure mode"},
        {"field": "init_offset_name", "type": "nominal", "title": "Initial lateral offset"},
        {"field": "use_reachsets", "type": "nominal", "title": "Reachable-set filter"},
        {"aggregate": "count", "title": "Runs"}
      ]
    }
  },
  "config": {
    "font": "CMU Serif",
    "title": {"font": "CMU Serif", "anchor": "middle", "fontSize": 22.5, "fontWeight": "normal"},
    "axis": {"labelFont": "CMU Serif", "titleFont": "CMU Serif", "titleFontWeight": "normal", "labelFontSize": 16.5, "titleFontSize": 18},
    "legend": {"labelFont": "CMU Serif", "titleFont": "CMU Serif", "titleFontWeight": "normal", "labelFontSize": 16.5, "titleFontSize": 18, "titleLimit": 400},
    "header": {"labelFont": "CMU Serif", "titleFont": "CMU Serif", "titleFontWeight": "normal", "labelFontSize": 18, "titleFontSize": 18},
    "text": {"font": "CMU Serif"},
    "view": {"stroke": "transparent"}
  }
}
