<config>
  <settings dt="0.01">
    <experiment_type>Simulation</experiment_type>
  </settings>
  <track>warehouse</track>
  <extensions>
    <extension handle="laptimer">Laptimer</extension>
    <extension handle="logger">Logger</extension>
    <!-- <extension handle='snapshot'>SnapshotSaver</extension> -->
    <extension car_graphics="True" handle="visualization">VisualizationGL</extension>
	<extension handle="simulator"
		match_time="False"
		state_noise_direction="adversarial_away"
		state_noise_enabled="True"
		state_noise_magnitude="0.1"
		state_noise_type="lateral_only">DynamicBicycleCartesianSimulator</extension>
    <extension handle="boundary_checker">BoundaryChecker</extension>
    <!-- <extension handle='gifsaver'>Gifsaver</extension> -->
  </extensions>
  <cars>
    <car>
      <name>Red Porsche</name>
      <hardware>Offboard</hardware>
      <config_name>audi_11</config_name>
      <controller horizon="30" max_speed="2.0" use_reachsets="False">
        <type>ImmraxController</type>
      </controller>
    </car>
  </cars>
</config>
